<%
// Avatar-Helfer: deterministische Initialen + Farbe aus dem Namen.
// Datensparsam (kein externer Service), generiert pro Person ein unverwechselbares Bild.
//
// hasAvatar(): prüft, ob eine Avatar-URL als "echt" gilt.
// - leerer String, Whitespace, relative Default-Pfade (/images/avatar*.*, /images/default*.*,
//   /images/user*.*, /uploads/default*.*) werden als fehlend behandelt
// - nur http(s)-URLs oder /uploads/-Pfade mit konkretem Dateinamen zählen als echter Avatar
function hasAvatar(url) {
  if (!url || typeof url !== 'string') return false;
  const u = url.trim();
  if (!u) return false;
  // Absolute URLs (http/https) gelten als echt
  if (/^https?:\/\//i.test(u)) return true;
  // Relative Pfade mit bekannten Platzhalter-Namen → ignorieren
  if (/\/(default|placeholder|avatar[-_]?default|user[-_]?default|no[-_]?avatar)/i.test(u)) return false;
  // Alles andere akzeptieren (/uploads/max.webp etc.)
  return true;
}
function avatarInitials(name) {
  if (!name || typeof name !== 'string') return '?';
  const parts = name.trim().replace(/[^\p{L}\p{N}\s&.-]/gu, '').split(/\s+/).filter(Boolean);
  if (parts.length === 0) return '?';
  const first = parts[0][0] || '';
  const last = parts.length > 1 ? parts[parts.length - 1][0] : '';
  return (first + last).toUpperCase().slice(0, 2);
}
function avatarColor(name) {
  const palette = [
    '#1e3a8a', '#0f766e', '#b45309', '#9f1239', '#047857',
    '#c2410c', '#0e7490', '#6b21a8', '#475569', '#be185d'
  ];
  return palette[avatarToneIndex(name)];
}
function avatarToneIndex(name) {
  let sum = 0;
  for (const ch of (name || '')) sum = (sum + ch.charCodeAt(0)) % 9973;
  return sum % 10;
}

const currentLang = typeof lng !== 'undefined' ? lng : 'de';
const isEn = currentLang === 'en';
const schemaBase = (typeof canonicalBaseUrl !== 'undefined' && canonicalBaseUrl
  ? canonicalBaseUrl
  : 'https://www.komplettwebdesign.de').replace(/\/$/, '');
const schemaHomeUrl = `${schemaBase}/`;
const schemaOrgId = `${schemaBase}/#organization`;
const schemaWebsiteId = `${schemaBase}/#website`;
const schemaPersonId = `${schemaBase}/#person`;
const faqEntries = (typeof faq !== 'undefined' && Array.isArray(faq)) ? faq : [];
const homeLowestPackagePriceLabel = typeof lowestPackagePriceLabel !== 'undefined' && lowestPackagePriceLabel
  ? lowestPackagePriceLabel
  : '';
const homePackagesPriceText = homeLowestPackagePriceLabel
  ? (isEn ? `clear website packages from ${homeLowestPackagePriceLabel}` : `klare Website-Pakete ab ${homeLowestPackagePriceLabel}`)
  : (isEn ? 'clear website packages' : 'klare Website-Pakete');
function homePackageAllowsDetail(pkg) {
  return pkg && pkg.allowDetailPage !== false && pkg.slug;
}
function homePackageTarget(pkg) {
  if (homePackageAllowsDetail(pkg)) return `${isEn ? '/en' : ''}/pakete/${pkg.slug}`;
  const packageValue = pkg && (pkg.packageKey || pkg.slug);
  return `${isEn ? '/en/kontakt' : '/kontakt'}${packageValue ? `?paket=${encodeURIComponent(packageValue)}` : ''}`;
}
function homePackageCtaLabel(pkg) {
  if (!homePackageAllowsDetail(pkg)) return isEn ? 'Request package' : 'Paket anfragen';
  return isEn ? 'View details' : 'Details ansehen';
}
const faqSchema = faqEntries.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
} : null;
const structuredDataBlocks = [
  faqSchema,
  typeof organizationSchema !== 'undefined' ? organizationSchema : null,
  typeof personSchema !== 'undefined' ? personSchema : null,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': schemaWebsiteId,
    name: 'Komplett Webdesign',
    url: schemaHomeUrl,
    description: `Webdesign Berlin: individuell programmierte Websites für kleine Unternehmen mit SEO-Grundlage und ${homePackagesPriceText}.`,
    publisher: { '@id': schemaOrgId },
    inLanguage: isEn ? 'en-US' : 'de-DE'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${schemaBase}/#webdesign-service`,
    name: 'Webdesign Berlin',
    serviceType: 'Webdesign und Webentwicklung',
    provider: { '@id': schemaOrgId },
    areaServed: [
      { '@type': 'City', name: 'Berlin' },
      { '@type': 'State', name: 'Brandenburg' },
      { '@type': 'Country', name: 'Deutschland' }
    ],
    description: 'Webdesign in Berlin für kleine Unternehmen: individuell programmierte Websites mit klarer Seitenstruktur, SEO-Grundlage und persönlicher Betreuung.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${schemaBase}/#webpage`,
    name: isEn ? 'Web design Berlin' : 'Webdesign Berlin',
    description: `Webdesign Berlin von Komplett Webdesign: individuell programmierte Websites für kleine Unternehmen, ${homePackagesPriceText} und persönliche Betreuung vom Erstgespräch bis nach dem Launch.`,
    url: schemaHomeUrl,
    inLanguage: isEn ? 'en-US' : 'de-DE',
    datePublished: '2024-01-01',
    dateModified: '2026-10-25',
    isPartOf: { '@id': schemaWebsiteId },
    about: [{ '@id': schemaOrgId }, { '@id': `${schemaBase}/#webdesign-service` }],
    author: { '@id': schemaPersonId },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: `${schemaBase}/images/home-hero-sauber-desktop.webp`,
      width: 1152,
      height: 720
    },
    relatedLink: [
      `${schemaBase}/pakete`,
      `${schemaBase}/webdesign-berlin/kosten-preise-pakete`,
      `${schemaBase}/leistungen/website-audit`,
      `${schemaBase}/kontakt`
    ],
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [{
        '@type': 'ListItem',
        position: 1,
        name: 'Startseite',
        item: schemaHomeUrl
      }]
    }
  }
].filter(Boolean);
const homeHeroBridgeHighlights = (typeof heroBridgeHighlights !== 'undefined' && Array.isArray(heroBridgeHighlights))
  ? heroBridgeHighlights
  : [];
const homeMarketingImages = (typeof marketingImages !== 'undefined' && marketingImages) ? marketingImages : {};
const homePackageImages = {
  start: homeMarketingImages.packageStart,
  business: homeMarketingImages.packageBusiness,
  wachstum: homeMarketingImages.packageGrowth,
  individuell: homeMarketingImages.packageCustom
};
%>
<%- include('partials/head', { structuredDataBlocks, alternateUrls: (typeof alternateUrls !== 'undefined' ? alternateUrls : null), extraCssAssets: ['home.css'] }) %>

<body class="home-body">
  <%- include('partials/header') %>
  <main class="home-page">
    <!-- 1) Hero-Section -->
    <section class="hero hero-main" id="hero">
      <div class="hero-section">
        <div class="container">
          <div class="hero-flex">
            <div class="hero-content home-hero-sequence">
              <span class="hero-badge mb-3 home-hero-reveal home-hero-reveal--support animate-on-scroll">
                <i class="fas fa-bolt"></i> <%= copy.heroBadge %>
              </span>
              <h1 class="display-5 fw-bold mt-2 home-hero-reveal home-hero-reveal--h1 animate-on-scroll">
                <span class="home-hero-title-primary"><%= copy.heroTitle %></span>
              </h1>
              <% if (copy.heroTitle2) { %>
              <p class="home-hero-claim home-hero-reveal home-hero-reveal--support animate-on-scroll"><%= copy.heroTitle2 %></p>
              <% } %>
              <p class="home-hero-lead home-hero-reveal home-hero-reveal--support animate-on-scroll"><%= copy.heroSubline %> <a href="/about"><%= isEn ? 'About me' : 'Mehr über mich' %></a></p>
              <ul class="home-hero-bullets" role="list">
                <li class="home-hero-reveal home-hero-reveal--bullet animate-on-scroll">
                  <img src="/images/icons/check.svg" alt="check icon" width="26" height="26" />
                  <span><%= copy.heroBullet1 %></span>
                </li>
                <li class="home-hero-reveal home-hero-reveal--bullet animate-on-scroll">
                  <img src="/images/icons/check.svg" alt="check icon" width="26" height="26" />
                  <span><%= copy.heroBullet2 %></span>
                </li>
                <li class="home-hero-reveal home-hero-reveal--bullet animate-on-scroll">
                  <img src="/images/icons/check.svg" alt="check icon" width="26" height="26" />
                  <span><%= copy.heroBullet3 %></span>
                </li>
              </ul>
              <div class="hero-ctas home-hero-reveal home-hero-reveal--actions animate-on-scroll">
                <a href="<%= isEn ? '/en/kontakt' : '/kontakt' %>" class="btn btn-primary" data-track="cta" data-cta-name="home_hero_contact" data-cta-location="home_hero"><%= copy.heroCtaPrimary %></a>
                <a href="<%= isEn ? '/en/pakete' : '/pakete' %>" class="btn btn-secondary" data-track="cta" data-cta-name="home_hero_packages" data-cta-location="home_hero"><%= copy.heroCtaSecondary %></a>
              </div>
              <% if (copy.heroTrustNote) { %>
              <p class="home-hero-trust-note home-hero-reveal home-hero-reveal--trust animate-on-scroll"><%= copy.heroTrustNote %></p>
              <% } %>
            </div>
            <div class="home-hero-showcase home-hero-reveal home-hero-reveal--visual animate-on-scroll" aria-label="<%= isEn ? 'Real client websites: TM Sauber & Mehr and Zur alten Backstube' : 'Echte Kundenprojekte: TM Sauber & Mehr und Zur alten Backstube' %>">
              <figure class="home-hero-showcase__main">
                <img src="<%= homeMarketingImages.homeHero?.src || '/images/home-hero-sauber-desktop.webp' %>" alt="<%= isEn ? 'Homepage of the TM Sauber & Mehr website, a commercial cleaning company in Berlin' : (homeMarketingImages.homeHero?.alt || 'Startseite der Website von TM Sauber & Mehr, einer Gebäudereinigung in Berlin') %>" width="1152" height="720" fetchpriority="high" loading="eager" decoding="async">
              </figure>
              <figure class="home-hero-showcase__detail">
                <img src="/images/home-hero-sauber-kontakt.webp" alt="<%= isEn ? 'Contact page of TM Sauber & Mehr with call and WhatsApp buttons' : 'Kontaktseite von TM Sauber & Mehr mit Anruf- und WhatsApp-Button' %>" width="1040" height="491" fetchpriority="low" loading="lazy" decoding="async">
              </figure>
              <figure class="home-hero-showcase__phone">
                <img src="/images/home-hero-backstube-mobile.webp" alt="<%= isEn ? 'Mobile view of the Zur alten Backstube café website' : 'Handy-Ansicht der Website vom Café Zur alten Backstube' %>" width="574" height="1344" fetchpriority="low" loading="lazy" decoding="async">
              </figure>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/hero-highlight-marquee', { heroBridgeHighlights: homeHeroBridgeHighlights, isEn, lng }) %>
    </section>

    <!-- 2) USP-Streifen -->
    <section class="section" id="usp-strip">
      <div class="container">
        <div class="home-usp-strip" aria-label="<%= isEn ? 'Key facts about the offer' : 'Kurzüberblick zum Angebot' %>">
          <div class="home-usp-item">
            <img class="home-usp-icon" src="/images/icons/gift1.svg" alt="" width="34" height="34" loading="lazy">
            <strong><%= isEn ? 'Personal implementation' : 'Persönliche Umsetzung' %></strong>
            <span>
              <% if (isEn) { %>
                One direct contact from first call to launch.
              <% } else { %>
                Du möchtest deine Website in Berlin erstellen lassen? Dann sprichst du vom ersten Gespräch bis zum Launch direkt mit mir, nicht mit wechselnden Agentur-Teams.
              <% } %>
            </span>
          </div>
          <div class="home-usp-item">
            <img class="home-usp-icon" src="/images/icons/individual1.svg" alt="" width="34" height="34" loading="lazy">
            <strong><%= isEn ? 'No builder templates' : 'Keine Standard-Templates' %></strong>
            <span><%= isEn ? 'Custom layouts instead of page-builder, WordPress template or theme work.' : 'Individuelle Layouts statt Baukasten, WordPress-Template oder Agentur-Schablone.' %></span>
          </div>
          <div class="home-usp-item">
            <img class="home-usp-icon" src="/images/icons/delivery1.svg" alt="" width="34" height="34" loading="lazy">
            <strong><%= isEn ? 'Fast and low-maintenance' : 'Schnell und wartungsarm' %></strong>
            <span><%= isEn ? 'Custom code instead of page builders and plugins: loads quickly and needs no constant plugin updates.' : 'Eigener Code statt Baukasten und Plugins: lädt schnell und braucht keine ständigen Plugin-Updates.' %></span>
          </div>
          <div class="home-usp-item">
            <img class="home-usp-icon" src="/images/icons/support1.svg" alt="" width="34" height="34" loading="lazy">
            <strong><%= isEn ? `Packages from ${lowestPackagePriceLabel || 'EUR'}` : `Pakete ab ${lowestPackagePriceLabel || ''}` %></strong>
            <span><%= isEn ? 'Clear scope, fixed feedback rounds and hosting from 5 EUR a month.' : 'Klarer Umfang, feste Feedbackrunden und Hosting ab 5 € im Monat.' %></span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3) Für wen das Angebot passt -->
    <section class="section" id="passt">
      <div class="container">
        <div class="outer-wrapper">
          <div class="inner-wrapper text-left animate-on-scroll">
            <span class="home-section-kicker"><i class="fas fa-user-check" aria-hidden="true"></i><%= isEn ? 'Fit' : 'Für wen das Angebot passt' %></span>
            <h2><%= isEn ? 'When an unclear website costs trust and inquiries' : 'Wenn eine unklare Website Vertrauen und Anfragen kostet' %></h2>
            <p class="home-section-lead">
              <% if (isEn) { %>
                Komplett Webdesign is a fit when you want a personal web designer, clear decisions and a website that is planned around inquiries, local visibility and maintainable technology.
              <% } else { %>
                Besucher springen ab, wenn Leistungen, Zielgruppe oder der nächste Schritt nicht schnell erkennbar sind. Gutes Webdesign in Berlin heißt für mich: Inhalte, Bilder und Kontaktwege so ordnen, dass dein Angebot sofort verständlich ist und Google deine Seite gut einordnen kann.
              <% } %>
            </p>
            <figure class="home-reference-band animate-on-scroll">
              <img src="<%= homeMarketingImages.homeProblem?.src || '/images/home-fit-beratung.webp' %>" alt="<%= isEn ? 'Personal website consultation for a small local business' : (homeMarketingImages.homeProblem?.alt || 'Entscheidungshilfe für ein Website-Projekt') %>" width="1280" height="720" loading="lazy" decoding="async">
              <figcaption>
                <h3><%= isEn ? 'A website that explains your offer quickly' : 'Ein Auftritt, der dein Angebot schnell verständlich macht' %></h3>
                <p>
                  <%= isEn
                    ? 'Visitors should understand who you help, what they can request and which next step makes sense without searching through the page.'
                    : 'Besucher sollen ohne Suchen erkennen, wem du hilfst, welche Leistung sie anfragen können und welcher nächste Schritt sinnvoll ist.'
                  %>
                </p>
              </figcaption>
            </figure>
            <div class="home-split">
              <div class="home-card">
                <h3><%= isEn ? 'Good fit' : 'Passt gut, wenn' %></h3>
                <ul class="home-list">
                  <li><%= isEn ? 'you run a local service, practice, shop, restaurant, trade or consulting business.' : 'du lokaler Dienstleister, Praxis, Händler, Gastronomie, Handwerk oder Berater bist.' %></li>
                  <li><%= isEn ? 'you want a compact or structured business website without a generic template.' : 'du eine kompakte oder strukturierte Unternehmenswebsite ohne Standard-Template möchtest.' %></li>
                  <li><%= isEn ? 'you value clear package boundaries, realistic timelines and direct feedback loops.' : 'du klare Paketgrenzen, realistische Zeitpläne und direkte Abstimmung schätzt.' %></li>
                </ul>
              </div>
              <div class="home-card">
                <h3><%= isEn ? 'What you get' : 'Das hast du davon' %></h3>
                <ul class="home-list">
                  <li><%= isEn ? 'visitors understand within seconds what you offer and how to reach you.' : 'Besucher verstehen in Sekunden, was du anbietest und wie sie dich erreichen.' %></li>
                  <li><%= isEn ? 'a website that looks as professional as your work.' : 'einen Auftritt, der so professionell wirkt wie deine Arbeit.' %></li>
                  <li><%= isEn ? 'one personal contact instead of a ticket system.' : 'einen festen Ansprechpartner statt Agentur-Ticketsystem.' %></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4) Leistungen -->
    <section class="section" id="leistungen">
      <div class="container">
        <div class="outer-wrapper">
          <div class="inner-wrapper text-left animate-on-scroll">
            <span class="home-section-kicker"><i class="fas fa-layer-group" aria-hidden="true"></i><%= isEn ? 'Services' : 'Leistungen' %></span>
            <h2><%= isEn ? copy.servicesTitle : 'Webdesign-Leistungen für kleine Unternehmen in Berlin' %></h2>
            <p class="home-section-lead">
              <%= isEn
                ? 'The homepage, package pages and inquiry path are planned together so visitors quickly understand your offer and can contact you without friction.'
                : 'Als Webdesigner in Berlin plane ich Startseite, Leistungsseiten und Anfrageweg zusammen, damit Besucher dein Angebot schnell verstehen und ohne Umwege Kontakt aufnehmen.'
              %>
            </p>
            <div class="home-card-grid">
              <article class="home-card home-service-card animate-on-scroll">
                <figure class="home-card-media">
                  <img src="<%= homeMarketingImages.homeSolution?.src || '/images/webdesign-berlin-individuelles-webdesign.webp' %>" alt="<%= isEn ? 'Custom web design example' : (homeMarketingImages.homeSolution?.alt || 'Beispiel für individuelles Webdesign') %>" width="540" height="338" loading="lazy" decoding="async">
                </figure>
                <div class="home-card-body">
                  <h3><%= isEn ? 'Website strategy and structure' : 'Website-Strategie und Struktur' %></h3>
                  <p><%= isEn ? 'Clear page architecture, priorities and content order before design starts.' : 'Klare Seitenstruktur, Prioritäten und Inhaltsreihenfolge, bevor das Design beginnt.' %></p>
                  <a href="/ablauf" class="linkColor"><%= isEn ? 'How a project works' : 'So läuft ein Projekt ab' %></a>
                </div>
              </article>
              <article class="home-card home-service-card animate-on-scroll">
                <figure class="home-card-media">
                  <img src="/images/home-responsive-frontend.webp" alt="<%= isEn ? 'Responsive website layouts on smartphone, tablet and desktop' : 'Responsive Website-Layouts auf Smartphone, Tablet und Desktop' %>" width="540" height="338" loading="lazy" decoding="async">
                </figure>
                <div class="home-card-body">
                  <h3><%= isEn ? 'Custom design and frontend' : 'Individuelles Design und Frontend' %></h3>
                  <p><%= isEn ? 'Responsive layouts for mobile, tablet and desktop, built to match your offer.' : 'Responsive Layouts für Smartphone, Tablet und Desktop, passend zu deinem Angebot.' %></p>
                  <a href="/referenzen" class="linkColor"><%= isEn ? 'View projects' : 'Projekte ansehen' %></a>
                </div>
              </article>
              <article class="home-card home-service-card animate-on-scroll">
                <figure class="home-card-media">
                  <img src="/images/seo.webp" alt="<%= isEn ? 'SEO structure and search visibility' : 'SEO-Struktur und Suchsichtbarkeit' %>" width="540" height="338" loading="lazy" decoding="async">
                </figure>
                <div class="home-card-body">
                  <h3><%= isEn ? 'Ready for Google' : 'Gut aufgestellt für Google' %></h3>
                  <p><%= isEn ? 'Clear page structure, page titles, descriptions and fast loading so Google understands your pages.' : 'Klare Seitenstruktur, Seitentitel, Beschreibungen und schnelle Ladezeiten, damit Google deine Seiten gut versteht.' %></p>
                  <a href="<%= isEn ? '/en/website-tester/seo' : '/website-tester/seo' %>" class="linkColor"><%= isEn ? 'Run SEO tester' : 'SEO-Tester starten' %></a>
                </div>
              </article>
              <article class="home-card home-service-card animate-on-scroll">
                <figure class="home-card-media">
                  <img src="/images/wartung.webp" alt="<%= isEn ? 'Website maintenance and relaunch planning' : 'Website-Wartung und Relaunch-Planung' %>" width="540" height="338" loading="lazy" decoding="async">
                </figure>
                <div class="home-card-body">
                  <h3><%= isEn ? 'Relaunch and expansion' : 'Relaunch und Ausbau' %></h3>
                  <p><%= isEn ? 'For existing websites with unclear structure, weak inquiries or outdated technical setup.' : 'Für bestehende Websites mit unklarer Struktur, schwachen Anfragen oder veralteter Technik.' %></p>
                  <a href="/leistungen/website-relaunch" class="linkColor"><%= isEn ? 'View relaunch page' : 'Relaunch-Seite ansehen' %></a>
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4b) Echte Projekte -->
    <% const homeProjectList = (typeof homeProjects !== 'undefined' && Array.isArray(homeProjects)) ? homeProjects : []; %>
    <% if (homeProjectList.length) { %>
    <section class="section" id="projekte" aria-labelledby="home-projects-title">
      <div class="container">
        <div class="outer-wrapper">
          <div class="inner-wrapper text-left animate-on-scroll">
            <span class="home-section-kicker"><i class="fas fa-images" aria-hidden="true"></i><%= isEn ? 'Projects' : 'Projekte' %></span>
            <h2 id="home-projects-title"><%= isEn ? 'Real projects from Berlin: what changed for my clients' : 'Webdesign aus Berlin: was sich für meine Kunden geändert hat' %></h2>
            <p class="home-section-lead"><%= isEn ? 'Three websites from Berlin, from a local café to a multilingual festival platform.' : 'Drei Websites aus Berlin, vom Café um die Ecke bis zur mehrsprachigen Festivalplattform.' %></p>
            <div class="home-project-grid">
              <% homeProjectList.forEach((project) => { %>
              <article class="home-project-card animate-on-scroll">
                <a class="home-project-card__media" href="<%= project.href %>" tabindex="-1" aria-hidden="true">
                  <img src="<%= project.image %>" alt="" width="<%= project.imageWidth %>" height="<%= project.imageHeight %>" loading="lazy" decoding="async">
                </a>
                <div class="home-project-card__body">
                  <p class="home-project-card__industry"><%= project.industry %></p>
                  <h3><a href="<%= project.href %>"><%= project.name %></a></h3>
                  <dl class="home-project-card__change">
                    <dt><%= isEn ? 'Before' : 'Vorher' %></dt>
                    <dd><%= project.before %></dd>
                    <dt><%= isEn ? 'After' : 'Nachher' %></dt>
                    <dd><%= project.after %></dd>
                  </dl>
                  <% if (project.quote) { %>
                  <blockquote class="home-project-card__quote">
                    <p>„<%= project.quote %>“</p>
                    <footer><%= project.quoteAuthor %></footer>
                  </blockquote>
                  <% } %>
                  <a class="home-project-card__link linkColor" href="<%= project.href %>"><%= isEn ? 'View project' : 'Projekt ansehen' %> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
              </article>
              <% }); %>
            </div>
            <p class="home-note"><a href="/referenzen" class="linkColor"><%= isEn ? 'All references with before-and-after screens' : 'Alle Referenzen mit Vorher-Nachher-Ansichten' %></a></p>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <!-- 5) Paket-Teaser -->
    <section class="section" id="preise" data-reveal-immediate>
      <div class="container">
        <div class="outer-wrapper home-section-shell">
          <div class="inner-wrapper text-left animate-on-scroll">
            <span class="home-section-kicker"><i class="fas fa-euro-sign" aria-hidden="true"></i><%= isEn ? 'Packages' : 'Pakete' %></span>
            <h2><%= copy.pricingTitle %></h2>
            <p class="home-section-lead">
              <%= isEn
                ? 'Every package has a fixed scope with a clear number of pages and feedback rounds. We discuss extra wishes before the start, so there are no surprises.'
                : 'Jedes Paket hat einen festen Umfang mit klarer Seitenzahl und festen Feedbackrunden. Zusatzwünsche besprechen wir vor dem Start, damit du keine Überraschungen erlebst.'
              %>
            </p>
