<%- include('partials/head', { extraCssAssets: ['about.css'] }) %>
<body class="about-page">
  <%- include('partials/header') %>
  <main class="about-main">
    <section id="about-hero" class="about-hero" aria-labelledby="about-title">
      <div class="about-shell about-hero__grid">
        <div class="about-hero__copy">
          <nav class="about-breadcrumbs" aria-label="Breadcrumb">
            <ol><li><a href="/">Startseite</a></li><li aria-current="page">Über mich</li></ol>
          </nav>
          <h1 id="about-title">Ich bin <em>Sören.</em><br> <span class="about-title__role">Dein Webdesigner</span> in Berlin.</h1>
          <p class="about-lead">Ich plane, gestalte und entwickle Websites für kleine Unternehmen. Mit direkter Abstimmung, verständlicher Beratung und einem klaren Weg bis zum Launch.</p>
          <div class="about-actions">
            <a class="about-button" href="/booking" data-track="cta" data-cta-name="about_consultation" data-cta-location="about_hero">Kennenlerngespräch vereinbaren</a>
            <a class="about-text-link" href="#meine-arbeit">Meine Arbeit ansehen</a>
          </div>
          <p class="about-note">Unverbindlich. Wir sprechen erst über dein Vorhaben.</p>
        </div>
        <figure class="about-portrait">
          <img src="/images/meinAvatar.webp" alt="Sören, dein persönlicher Webdesigner und Entwickler in Berlin" width="480" height="480" fetchpriority="high" decoding="async">
          <figcaption>Sören · Webdesigner und Entwickler</figcaption>
        </figure>
      </div>
      <ul class="about-shell about-highlights" aria-label="Zusammenarbeit auf einen Blick">
        <% aboutPage.highlights.forEach(item => { %>
        <li><strong><%= item.title %></strong><p><%= item.text %></p></li>
        <% }) %>
      </ul>
    </section>

    <section class="about-intro about-shell" aria-labelledby="about-intro-title" data-reveal>
      <div class="about-intro__heading">
        <h2 id="about-intro-title">Du musst kein Website-Profi sein.<br> Dafür hast du mich.</h2>
        <div class="about-intro__text">
          <p>Ich bin Sören Blocksdorf, der Mensch hinter Komplett Webdesign in Berlin. Ich mag es, wenn aus einer ersten Idee ein Webauftritt wird, der zu einem Unternehmen und den Menschen dahinter passt.</p>
          <p>Du kennst deinen Betrieb. Ich bringe Struktur, Gestaltung und Technik zusammen. Ich höre zu, frage nach und erkläre dir die Entscheidungen so, dass du sie nachvollziehen kannst.</p>
          <p>Ob du neu startest oder deine bestehende Website überarbeiten möchtest: Wir schauen zuerst auf dein Angebot, deine Kunden und dein Ziel. Daraus entwickeln wir den passenden nächsten Schritt.</p>
        </div>
      </div>
      <ol class="about-principles">
        <% aboutPage.principles.forEach((item, index) => { %>
        <li><span class="about-principles__number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span><h3><%= item.title %></h3><p><%= item.text %></p></li>
        <% }) %>
      </ol>
      <div class="about-scope">
        <p>Von <a href="/">individuellem Webdesign</a> bis zum <a href="/leistungen/website-relaunch">Website-Relaunch</a>: Der Umfang richtet sich nach deinem Vorhaben. Hosting, Domain, E-Mail und Wartung werden separat vereinbart.</p>
        <a class="about-text-link" href="/pakete">Website-Pakete und Leistungsumfang ansehen <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
      </div>
    </section>

    <section id="meine-arbeit" class="about-proof about-shell" aria-labelledby="about-proof-title">
      <% const project = aboutPage.featuredProject; %>
      <h2 id="about-proof-title" class="about-proof__heading">Einblicke in meine Arbeit<span>.</span></h2>
      <article class="about-featured-project" id="projekt-zur-alten-backstube" aria-labelledby="projekt-titel-zur-alten-backstube" data-reveal>
      <h3 id="projekt-titel-zur-alten-backstube" class="about-project-title"><%= project.name %></h3>
      <div class="about-proof__grid">
        <a class="about-project-image" href="/referenzen/<%= project.slug %>" aria-label="Referenzprojekt <%= project.name %> ansehen">
          <picture>
            <source media="(max-width: 600px)" srcset="/images/review-bg-mobile.webp">
            <img src="<%= project.image %>" alt="<%= project.imageAlt %>" width="2048" height="1173" loading="lazy" decoding="async">
          </picture>
        </a>
        <div class="about-proof__copy">
          <p class="about-project-kicker">Atmosphäre zeigen. Reservierungen vereinfachen.</p>
          <p>Für das Café Zur alten Backstube habe ich Atmosphäre, Angebot und Kontaktwege zu einem stimmigen Webauftritt verbunden.</p>
          <a class="about-text-link about-text-link--accent" href="/referenzen/<%= project.slug %>">Projekt <%= project.name %> ansehen <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
          <figure class="about-quote">
            <blockquote><p><%= project.quote %></p></blockquote>
            <figcaption><%= project.quoteAuthor %> · Kundenstimme <a href="<%= siteFacts.googleProfileUrl %>" target="_blank" rel="noopener">Auf Google ansehen</a></figcaption>
          </figure>
        </div>
      </div>
      </article>
      <% aboutPage.showcases.forEach(example => { %>
      <article class="about-showcase" id="projekt-<%= example.project.slug %>" aria-labelledby="projekt-titel-<%= example.project.slug %>" data-reveal>
        <h3 class="about-project-title" id="projekt-titel-<%= example.project.slug %>"><%= example.project.name %></h3>
        <div class="about-showcase__intro">
          <div>
            <p><%= example.description %></p>
            <a class="about-text-link about-text-link--accent" href="/referenzen/<%= example.project.slug %>">Projekt <%= example.project.name %> kennenlernen <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
          </div>
          <div class="about-showcase__feature">
            <h4><span class="about-feature-label">Besonders</span><span><%= example.featureTitle.replace(/^Besonders:\s*/, '') %></span></h4>
            <p><%= example.featureText %></p>
            <a class="about-text-link" href="<%= example.featureUrl %>" target="_blank" rel="noopener"><%= example.featureLabel %> <span class="visually-hidden">(öffnet in einem neuen Tab)</span></a>
          </div>
        </div>
        <div class="about-showcase__screens about-showcase__screens--<%= example.screens.length %>">
          <% example.screens.forEach(screen => { %>
          <figure>
            <a href="<%= screen.image %>" target="_blank" rel="noopener" aria-label="Screenshot vergrößern: <%= screen.caption %> – <%= example.project.name %> (öffnet in einem neuen Tab)">
              <img src="<%= screen.image %>" srcset="<%= screen.image.replace('.webp', '-720.webp') %> 720w, <%= screen.image %> <%= screen.width %>w" sizes="(max-width: 760px) calc(100vw - 40px), <%= example.screens.length === 3 ? '(max-width: 1100px) calc((100vw - 104px) / 3), 411px' : '(max-width: 1100px) calc((100vw - 104px) / 2), 628px' %>" width="<%= screen.width %>" height="<%= screen.height %>" alt="<%= screen.alt %>" loading="lazy" decoding="async">
            </a>
            <figcaption><%= screen.caption %> <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10"/></svg></figcaption>
          </figure>
          <% }) %>
        </div>
        <a class="about-text-link about-showcase__live" href="<%= example.liveUrl %>" target="_blank" rel="noopener"><%= example.liveLabel %> <span class="visually-hidden">(öffnet in einem neuen Tab)</span></a>
      </article>
      <% }) %>
    </section>

    <section class="about-process" aria-labelledby="about-process-title" data-reveal>
      <div class="about-shell">
        <h2 id="about-process-title">Ein klarer Ablauf. <em>Ein gutes Gefühl.</em></h2>
        <ol class="about-steps">
          <% aboutPage.steps.forEach((step, index) => { %>
          <li><span class="about-steps__number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span><h3><%= step.title %></h3><p><%= step.text %></p></li>
          <% }) %>
        </ol>
      </div>
    </section>

    <section class="about-close about-shell" aria-label="Fragen und persönlicher Kontakt">
      <div class="about-faq">
        <h2>Gut zu wissen<span>.</span></h2>
        <div class="about-faq__items">
        <% aboutPage.faq.forEach(item => { %>
        <details>
          <summary><%= item.question %><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-7-7v14"/></svg></summary>
          <p><%= item.answer %></p>
        </details>
        <% }) %>
        </div>
      </div>
      <div class="about-contact" data-reveal>
        <h2>Erzähl mir, was du vorhast<span>.</span></h2>
        <p>Ob erste Website oder Relaunch: Wir klären gemeinsam, welcher nächste Schritt zu deinem Unternehmen passt.</p>
        <div class="about-contact__actions">
        <a class="about-button" href="/booking" data-track="cta" data-cta-name="about_consultation" data-cta-location="about_contact">Kennenlerngespräch vereinbaren <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
        <a class="about-button about-button--secondary" href="mailto:<%= siteFacts.email %>?subject=<%= encodeURIComponent('Anfrage zu meiner Website') %>&amp;body=<%= encodeURIComponent('Sag mir kurz was du benötigst oder was du dir vorstellst:') %>">Oder schreib mir dein Vorhaben</a>
        </div>
      </div>
    </section>
  </main>
  <script src="<%= typeof jsAsset === 'function' ? jsAsset('js/about-page.js') : '/js/about-page.js' %>" defer></script>
  <%- include('partials/footer') %>
</body>
</html>
