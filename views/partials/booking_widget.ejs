<% const isEn = typeof lng !== 'undefined' && lng === 'en'; %>
<%
  // Optionaler Audit-Kontext aus /booking?src=…&domain=…&score=…
  // Wird vom bookingController in res.locals gelegt.
  const bookingCtx = (typeof booking_context !== 'undefined' && booking_context) ? booking_context : null;
  let prefillNote = '';
  if (bookingCtx) {
    const parts = [];
    if (bookingCtx.src) parts.push(isEn ? `Via ${bookingCtx.src}` : `Anfrage über ${bookingCtx.src}`);
    if (bookingCtx.domain) parts.push(isEn ? `Website: ${bookingCtx.domain}` : `Website: ${bookingCtx.domain}`);
    if (bookingCtx.score !== null && bookingCtx.score !== undefined && bookingCtx.score !== '') {
      parts.push(isEn ? `Current score: ${bookingCtx.score}/100` : `Aktueller Score: ${bookingCtx.score}/100`);
    }
    prefillNote = parts.join(' · ');
  }
%>
<div class="kwd-booking-widget" data-sitekey="<%= process.env.RECAPTCHA_SITEKEY %>" data-lng="<%= isEn ? 'en' : 'de' %>">
  <div class="kwd-booking-flow">
    <aside class="kwd-cal-left" aria-label="<%= isEn ? 'Choose your appointment date' : 'Termintag auswählen' %>">
      <p class="kwd-panel-label"><span aria-hidden="true">01</span> <%= isEn ? 'Day and time' : 'Tag und Uhrzeit' %></p>
      <div class="kwd-cal-header">
        <button class="kwd-nav" type="button" data-dir="-1" aria-label="<%= isEn ? 'Previous month' : 'Vorheriger Monat' %>">‹</button>
        <h3 class="kwd-month-label"></h3>
        <button class="kwd-nav" type="button" data-dir="+1" aria-label="<%= isEn ? 'Next month' : 'Nächster Monat' %>">›</button>
      </div>
      <div class="kwd-weekday-row"></div>
      <div class="kwd-grid-days" aria-busy="true"></div>
      <p class="kwd-calendar-legend"><span aria-hidden="true"></span><%= isEn ? 'Available days' : 'Tage mit freien Terminen' %></p>
      <p class="kwd-timezone"><%= isEn ? 'All times are in Berlin local time.' : 'Alle Uhrzeiten in Berliner Ortszeit.' %></p>
    </aside>

    <section class="kwd-cal-right">
      <div class="kwd-step kwd-step-day">
        <p class="kwd-hint" role="status" aria-live="polite"><%= isEn ? 'Finding your first available appointment…' : 'Dein nächster freier Termin wird gesucht …' %></p>
        <button class="kwd-retry" type="button" hidden><%= isEn ? 'Try again' : 'Erneut versuchen' %></button>
      </div>

      <div class="kwd-step kwd-step-times" hidden>
        <button type="button" class="kwd-back-btn" data-back="days">← <%= isEn ? 'Back to calendar' : 'Zurück zum Kalender' %></button>
        <h4 class="kwd-selected-date"></h4>
        <p class="kwd-step-subline"><%= isEn ? 'Choose a time:' : 'Wähle eine Uhrzeit:' %></p>
        <div class="kwd-time-list"></div>
      </div>

      <div class="kwd-step kwd-step-form" hidden>
        <p class="kwd-panel-label"><span aria-hidden="true">02</span> <%= isEn ? 'Your details' : 'Deine Angaben' %></p>
        <p class="kwd-selected-summary" aria-live="polite"></p>
        <button type="button" class="kwd-back-btn" data-back="times"><%= isEn ? 'Change time' : 'Uhrzeit ändern' %> <span aria-hidden="true">↗</span></button>
        <p class="kwd-selection-note"><%= isEn ? 'Not booked yet. You can also choose a different day in the calendar.' : 'Noch nicht gebucht. Einen anderen Tag wählst du direkt im Kalender.' %></p>
        <form class="kwd-booking-form" action="/booking" method="POST">
          <input type="hidden" name="slotId">
          <input type="hidden" name="locale" value="<%= isEn ? 'en' : 'de' %>">
          <input type="hidden" name="g-recaptcha-response" />

          <label class="kwd-field">
            <span><%= isEn ? 'Name' : 'Name' %></span>
            <input type="text" name="name" required minlength="2" maxlength="120" placeholder="<%= isEn ? 'e.g. Alex Taylor' : 'z. B. Alex Müller' %>" autocomplete="name" aria-describedby="booking-name-help">
            <small id="booking-name-help" class="form-help"><%= isEn ? 'Enter the name for the appointment confirmation.' : 'Gib den Namen für die Terminbestätigung ein.' %></small>
          </label>

          <div class="kwd-stage kwd-email-stage">
          <label class="kwd-field">
            <span><%= isEn ? 'Email' : 'E-Mail' %></span>
            <input type="email" name="email" required maxlength="254" placeholder="<%= isEn ? 'alex@your-company.com' : 'alex@dein-unternehmen.de' %>" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" aria-describedby="booking-email-help">
            <small id="booking-email-help" class="form-help"><%= isEn ? 'Use an address where you can receive the confirmation link.' : 'Nutze eine Adresse, unter der du die Terminbestätigung erhältst.' %></small>
          </label>

          </div>
          <div class="kwd-stage kwd-details-stage">
          <label class="kwd-field">
            <span><%= isEn ? 'Your project (optional)' : 'Dein Vorhaben (optional)' %></span>
            <textarea name="note" rows="3" maxlength="2000" placeholder="<%= isEn ? 'What do you need, or what do you have in mind? A few words are enough.' : 'Was benötigst du oder was stellst du dir vor? Ein paar Stichpunkte reichen.' %>" aria-describedby="booking-note-help"><%= prefillNote %></textarea>
            <small id="booking-note-help" class="form-help"><%= isEn ? 'Optional: add context for the call, for example your website or project goal.' : 'Optional: Ergänze kurz Kontext, zum Beispiel Website oder Projektziel.' %></small>
          </label>

          <p class="kwd-privacy"><%= isEn ? 'I use your details to arrange our conversation.' : 'Ich nutze deine Angaben, um unser Gespräch zu organisieren.' %> <a href="/datenschutz"><%= isEn ? 'Privacy policy' : 'Datenschutz' %></a></p>
          <button class="btn btn-primary kwd-submit" type="submit"><%= isEn ? 'Book my free consultation' : 'Kennenlerngespräch vereinbaren' %> <span aria-hidden="true">→</span></button>
          </div>
          <p class="form-msg" role="alert" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </div>
  <noscript><p class="kwd-no-script"><%= isEn ? 'Please enable JavaScript to choose a time, or email me to arrange an appointment.' : 'Aktiviere JavaScript für die Terminauswahl oder vereinbare dein Gespräch per E-Mail.' %></p></noscript>
</div>

<script type="module" src="<%= (typeof jsAsset === 'function' ? jsAsset('js/booking-widget.js') : '/js/booking-widget.js?v=' + encodeURIComponent(assetVersion || '1')) %>" defer></script>
