<% const bezirke = [
  ['reinickendorf', 'Reinickendorf', 'Reinickendorf', 1, 2], ['pankow', 'Pankow', 'Pankow', 1, 3],
  ['spandau', 'Spandau', 'Spandau', 2, 1], ['charlottenburg-wilmersdorf', 'Charlottenburg-Wilmersdorf', 'Charl.-Wilm.', 2, 2], ['mitte', 'Mitte', 'Mitte', 2, 3], ['friedrichshain-kreuzberg', 'Friedrichshain-Kreuzberg', 'Friedr.-Kreuzb.', 2, 4], ['lichtenberg', 'Lichtenberg', 'Lichtenberg', 2, 5], ['marzahn-hellersdorf', 'Marzahn-Hellersdorf', 'Marz.-Hellersd.', 2, 6],
  ['steglitz-zehlendorf', 'Steglitz-Zehlendorf', 'Stegl.-Zehl.', 3, 2], ['tempelhof-schoeneberg', 'Tempelhof-Schöneberg', 'Temp.-Schöneb.', 3, 3], ['neukoelln', 'Neukölln', 'Neukölln', 3, 4], ['treptow-koepenick', 'Treptow-Köpenick', 'Trept.-Köp.', 3, 5]
]; const aktiv = new Set(section.active || []); %>
<div class="bt-karte">
  <figure class="bt-karte__figur<%= rv %>">
    <ul class="bt-karte__kacheln" aria-label="<%= section.mapLabel %>">
      <% bezirke.forEach(([key, name, kurz, zeile, spalte]) => { %>
      <li class="bt-karte__kachel<%= aktiv.has(key) ? ' is-aktiv' : '' %>" style="--zeile: <%= zeile %>; --spalte: <%= spalte %>"><abbr title="<%= name %>"><%= kurz %></abbr><span class="visually-hidden"><%= aktiv.has(key) ? ' (eigene Bezirksseite)' : '' %></span></li>
      <% }) %>
    </ul>
    <figcaption><span class="bt-karte__legende" aria-hidden="true"></span><%= section.legend %></figcaption>
  </figure>
  <div class="bt-karte__punkte<%= rv %>">
    <h3><%= section.pointsTitle %></h3>
    <ul class="wd-list wd-list--checks">
      <% section.points.forEach((point) => { %><li><%= point %></li><% }) %>
    </ul>
  </div>
</div>
