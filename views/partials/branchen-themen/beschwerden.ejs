<% const punkte = { kiefer: [118, 66], nacken: [110, 96], schulter: [74, 114], ruecken: [110, 196], knie: [92, 330], fuss: [130, 412] }; %>
<div class="bt-koerper">
  <figure class="bt-koerper__figur<%= rv %>">
    <svg viewBox="0 0 220 440" role="img" aria-label="<%= section.figureLabel %>">
      <g class="bt-koerper__form">
        <circle cx="110" cy="46" r="27"/>
        <line x1="110" y1="70" x2="110" y2="98" stroke-width="18"/>
        <rect x="72" y="94" width="76" height="150" rx="32"/>
        <line x1="70" y1="112" x2="46" y2="236" stroke-width="22"/>
        <line x1="150" y1="112" x2="174" y2="236" stroke-width="22"/>
        <line x1="94" y1="236" x2="90" y2="416" stroke-width="28"/>
        <line x1="126" y1="236" x2="130" y2="416" stroke-width="28"/>
      </g>
      <% section.regions.forEach((region, index) => { const [x, y] = punkte[region.key] || [110, 220]; %>
      <g class="bt-koerper__punkt bt-farbe-<%= (index % 4) + 1 %>">
        <circle class="bt-koerper__ring" cx="<%= x %>" cy="<%= y %>" r="15"/>
        <circle cx="<%= x %>" cy="<%= y %>" r="12"/>
        <text x="<%= x %>" y="<%= y + 4.5 %>" text-anchor="middle"><%= index + 1 %></text>
      </g>
      <% }) %>
    </svg>
  </figure>
  <ol class="bt-koerper__liste">
    <% section.regions.forEach((region, index) => { %>
    <li class="bt-farbe-<%= (index % 4) + 1 %><%= rv %>">
      <span class="bt-koerper__nr" aria-hidden="true"><%= index + 1 %></span>
      <h3><%= region.name %></h3>
      <p class="bt-query"><span class="visually-hidden">Suchbeispiel: </span>„<%= region.query %>“</p>
      <p><%= region.text %></p>
    </li>
    <% }) %>
  </ol>
</div>
