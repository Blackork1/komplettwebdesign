<% if (typeof siteFacts !== 'undefined') { %>
<address class="business-contact">
  <strong><%= siteFacts.brandName %> · <%= siteFacts.founderName %></strong><br>
  <%= siteFacts.address.streetAddress %>, <%= siteFacts.address.postalCode %> <%= siteFacts.address.addressLocality %><br>
  <a href="tel:<%= siteFacts.phone %>"><%= siteFacts.phoneDisplay %></a> ·
  <a href="mailto:<%= siteFacts.email %>"><%= siteFacts.email %></a><br>
  <a href="<%= siteFacts.googleProfileUrl %>" target="_blank" rel="noopener">Google-Unternehmensprofil</a> ·
  <a href="<%= siteFacts.addressMapUrl %>" target="_blank" rel="noopener">Adresse auf Google Maps</a>
</address>
<% } %>
