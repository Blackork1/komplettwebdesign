<% if (typeof siteFacts !== 'undefined') { const isCompact = typeof compact !== 'undefined' && compact; %>
<address class="business-contact<%= isCompact ? ' business-contact--compact' : '' %>">
  <strong><%= siteFacts.brandName %><% if (!isCompact) { %> · <%= siteFacts.founderName %><% } %></strong>
  <% if (!isCompact) { %><span><%= siteFacts.address.streetAddress %>, <%= siteFacts.address.postalCode %> <%= siteFacts.address.addressLocality %></span><% } %>
  <a href="tel:<%= siteFacts.phone %>"><%= siteFacts.phoneDisplay %></a>
  <a href="mailto:<%= siteFacts.email %>"><%= siteFacts.email %></a>
  <a href="<%= siteFacts.googleProfileUrl %>" target="_blank" rel="noopener"><%= typeof lng !== 'undefined' && lng === 'en' ? 'Google business profile' : 'Google-Unternehmensprofil' %></a>
</address>
<% } %>
