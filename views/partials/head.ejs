<!DOCTYPE html>
<html lang="<%= (typeof lng !== 'undefined' && lng === 'en') ? 'en' : 'de' %>">

<head>
  <%
  const pageTitle = (typeof title !== 'undefined' && title) ? title : 'Komplett Webdesign | Website erstellen lassen in Berlin';
  const pageDescription = (typeof description !== 'undefined' && description) ? description : 'Professionelles Webdesign in Berlin: Website erstellen lassen mit Fokus auf Sichtbarkeit, Performance und Anfragen.';
  const seoExtraText = (typeof seoExtra !== 'undefined' && typeof seoExtra === 'string') ? seoExtra : '';
  const hasCanonical = /rel=["']canonical["']/i.test(seoExtraText);
  const hasOgTitle = /property=["']og:title["']/i.test(seoExtraText);
  const hasOgDescription = /property=["']og:description["']/i.test(seoExtraText);
  const hasOgUrl = /property=["']og:url["']/i.test(seoExtraText);
  const hasOgImage = /property=["']og:image["']/i.test(seoExtraText);
  const hasOgType = /property=["']og:type["']/i.test(seoExtraText);
  const hasTwitterCard = /name=["']twitter:card["']/i.test(seoExtraText);
  const hasRobots = /name=["']robots["']/i.test(seoExtraText);
  const trackingDisabled = typeof disableTracking !== 'undefined' && disableTracking === true;
  const siteBase = (canonicalBaseUrl || 'https://www.komplettwebdesign.de').replace(/\/$/, '');
  const pageCanonical = canonicalUrl || `${siteBase}/`;
  const defaultOgImage = (typeof ogImage !== 'undefined' && typeof ogImage === 'string' && ogImage.trim())
    ? ogImage.trim()
    : `${siteBase}/images/heroBg.webp`;
  const assetV = encodeURIComponent(assetVersion || '1');
  const safeTrackingContext = (typeof trackingContext === 'object' && trackingContext) ? trackingContext : {};
  const versionedAsset = (typeof asset === 'function')
    ? asset
    : (file) => {
        const normalized = String(file || '').replace(/^\/+/, '');
        return `/${normalized}?v=${assetV}`;
      };
  const shouldLoadInteractionPolish = typeof disableInteractionPolish === 'undefined' || !disableInteractionPolish;
  const rawPageCssAssets = typeof extraCssAssets !== 'undefined' ? extraCssAssets : [];
  const pageCssAssets = Array.isArray(rawPageCssAssets)
    ? rawPageCssAssets.filter(Boolean)
    : [];
  %>
  <meta charset="UTF-8" />
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="<%= pageDescription %>" />
  <% if (!hasRobots) { %>
  <meta name="robots" content="<%= robots || 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1' %>" />
  <% } %>
  <% if (typeof keywords === 'string' && keywords.trim()) { %>
  <meta name="keywords" content="<%= keywords %>" />
  <% } %>
  <% if (!hasCanonical) { %>
  <link rel="canonical" href="<%= pageCanonical %>" />
  <% } %>
  <%
    // hreflang-Tags: Controller kann ein Objekt übergeben, z.B.
    //   alternateUrls = { de: '...', en: '...', xDefault: '...' }
    // Fallback: keine Tags ausgeben (dann ignoriert Google die Sprachsignale, wie bisher).
    const hasHreflangInExtra = /rel=["']alternate["'][^>]*hreflang=/i.test(seoExtraText);
    if (!hasHreflangInExtra && typeof alternateUrls === 'object' && alternateUrls) {
  %>
  <% if (alternateUrls.de) { %>
  <link rel="alternate" hreflang="de-DE" href="<%= alternateUrls.de %>" />
  <% } %>
  <% if (alternateUrls.en) { %>
  <link rel="alternate" hreflang="en" href="<%= alternateUrls.en %>" />
  <% } %>
  <% if (alternateUrls.xDefault) { %>
  <link rel="alternate" hreflang="x-default" href="<%= alternateUrls.xDefault %>" />
  <% } %>
  <% } %>
  <% if (!hasOgType) { %>
  <meta property="og:type" content="website" />
  <% } %>
  <% if (!hasOgTitle) { %>
  <meta property="og:title" content="<%= pageTitle %>" />
  <% } %>
  <% if (!hasOgDescription) { %>
  <meta property="og:description" content="<%= pageDescription %>" />
  <% } %>
  <% if (!hasOgUrl) { %>
  <meta property="og:url" content="<%= pageCanonical %>" />
  <% } %>
  <% if (!hasOgImage) { %>
  <meta property="og:image" content="<%= defaultOgImage %>" />
  <% } %>
  <% if (!hasTwitterCard) { %>
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= pageDescription %>" />
  <meta name="twitter:image" content="<%= defaultOgImage %>" />
  <% } %>

  <!-- Fonts / CSS (wie bei dir) -->
  <% if (shouldLoadInteractionPolish) { %>
  <script>
    document.documentElement.classList.add('kwd-interaction-polish');
  </script>
  <% } %>

  <%# Schriften Inter/Poppins (verkleinert, siehe AGENTS.md). Auf einer bereits sichtbaren Seite wird die Schrift
     nie gewechselt (das ließe Text umbrechen und die Seite springen):
     - Erster Besuch: die Seite bleibt bei den abgestimmten Ersatzschriften aus css/main.css; nach dem Laden
       holt der Browser die Schriften im Hintergrund in den Cache (bremst weder Text noch LCP).
     - Danach (nächste Seite, spätere Besuche): Schriften gelten von Anfang an (font-display: optional,
       aus dem Cache; sind sie ausnahmsweise nicht rechtzeitig da, bleibt die Ersatzschrift ohne Wechsel). %>
  <% const webfontList = [
    ['Inter', 400, versionedAsset('fonts/inter-400.woff2')],
    ['Inter', 600, versionedAsset('fonts/inter-600.woff2')],
    ['Poppins', 400, versionedAsset('fonts/poppins-400.woff2')],
    ['Poppins', 700, versionedAsset('fonts/poppins-700.woff2')]
  ];
  const webfontRange = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2190-2199,U+2212,U+2215';
  const webfontFaces = (display) => webfontList.map(([family, weight, url]) => `@font-face{font-family:"${family}";font-style:normal;font-weight:${weight};font-display:${display};src:url(${url}) format("woff2");unicode-range:${webfontRange}}`).join(''); %>
  <style id="kwd-webfonts" media="print"><%- webfontFaces('optional') %></style>
  <noscript><style><%- webfontFaces('swap') %></style></noscript>
  <script>
    (function () {
      var style = document.getElementById('kwd-webfonts');
      var key = 'kwdWebfonts';
      var fonts = <%- JSON.stringify(webfontList) %>;
      var known = false;
      try { known = localStorage.getItem(key) === '1'; } catch (e) {}
      if (known && style) {
        style.media = 'all';
        return;
      }
      if (!window.FontFace) return;
      // Erst wenn die Seite geladen UND der größte Inhalt (LCP) gezeichnet ist.
      var loaded = false;
      var painted = true;
      var started = false;
      function warmCache() {
        if (!loaded || !painted || started) return;
        started = true;
        setTimeout(function () {
          // Nur in den Cache laden, nicht auf dieser Seite anwenden.
          Promise.all(fonts.map(function (font) {
            return new FontFace(font[0], 'url(' + font[2] + ')', { weight: String(font[1]) }).load();
          })).then(function () {
            try { localStorage.setItem(key, '1'); } catch (e) {}
          }).catch(function () {});
        }, 0);
      }
      try {
        if (PerformanceObserver.supportedEntryTypes.indexOf('largest-contentful-paint') !== -1) {
          painted = false;
          new PerformanceObserver(function (list, observer) {
            observer.disconnect();
            painted = true;
            warmCache();
          }).observe({ type: 'largest-contentful-paint', buffered: true });
        }
      } catch (e) { painted = true; }
      window.addEventListener('load', function () { loaded = true; warmCache(); }, { once: true });
    })();
  </script>

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <%# Icons: nur die verwendeten Font-Awesome-Icons (scripts/buildIconSubset.mjs), 19 statt 113 KB Schrift.
     Gleiche URL wie in icons.min.css (url(fa-solid-900-subset.woff2?v=<Inhalts-Hash>)), sonst lädt der Browser die Schrift doppelt. %>
  <link rel="preload" href="<%= versionedAsset('assets/css/fa-solid-900-subset.woff2') %>" as="font" type="font/woff2" crossorigin />

  <link rel="preload" href="<%= versionedAsset('assets/css/icons.min.css') %>" as="style" onload="this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="<%= versionedAsset('assets/css/icons.min.css') %>" />
  </noscript>

  <%# Kein Preload für Inter/Poppins: Die meisten Seiten binden diese Schriften gar nicht per @font-face ein,
     der Preload kostete dort nur Bandbreite (Chrome: "preloaded but not used"). %>

  <%# Öffentliche Seiten: Bootstrap nur mit den genutzten Regeln (scripts/buildBootstrapSubset.mjs). Adminbereich: komplett. %>
  <% if (typeof currentPathname === 'string' && /^\/admin(\/|$)/.test(currentPathname)) { %>
  <link rel="stylesheet" href="<%= versionedAsset('css/bootstrap.min.css') %>" />
  <% } else { %>
  <link rel="stylesheet" href="<%= cssAsset('css/bootstrap-site.css') %>" />
  <% } %>

  <link rel="stylesheet" href="<%= cssAsset('css/main.css') %>" />

  <link rel="stylesheet" href="<%= cssAsset('unified-hero.css') %>" />

  <% if (shouldLoadInteractionPolish) { %>
  <link rel="stylesheet" href="<%= cssAsset('interaction-polish.css') %>" />
  <% } %>

  <link rel="preload" href="<%= cssAsset('extra.css') %>" as="style" onload="this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="<%= cssAsset('extra.css') %>" />
  </noscript>

  <link rel="stylesheet" href="<%= cssAsset('footer.css') %>" />

  <link rel="preload" href="<%= cssAsset('booking-widget.css') %>" as="style" onload="this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet" href="<%= cssAsset('booking-widget.css') %>" />
  </noscript>

  <% pageCssAssets.forEach((cssFile) => { %>
  <link rel="stylesheet" href="<%= cssAsset(cssFile) %>" />
  <% }) %>
  <%# Zuletzt: einheitlicher 16-px-Seitenabstand auf dem Smartphone für alle Seiten. %>
  <link rel="stylesheet" href="<%= cssAsset('mobile-gutter.css') %>" media="(max-width: 767.98px)" />

  <% if (!trackingDisabled) { %>
  <!-- Stripe lazy loader (wie bei dir) -->
  <script>
    window.ensureStripe = function(pk) {
      return new Promise(resolve => {
        if (window.Stripe) return resolve(window.Stripe(pk));
        const s = document.createElement('script');
        s.src = "https://js.stripe.com/v3/";
        s.async = true;
        s.onload = () => resolve(window.Stripe(pk));
        document.head.appendChild(s);
      });
    };

    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-open-checkout]');
      if (!btn) return;
      e.preventDefault();
      const stripe = await window.ensureStripe("<%= process.env.STRIPE_PUBLISHABLE_KEY %>");
      // await stripe.redirectToCheckout({ sessionId: '...' });
    }, {
      passive: false
    });
  </script>
  <% } %>

  <!-- Favicon / Manifest -->
  <link rel="icon" type="image/png" sizes="16x16" href="/images/icon16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/icon32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icon192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/icon180.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <% if (seoExtraText) { %>
  <%- seoExtraText %>
  <% } %>

  <% const identityBlocks = [
    typeof organizationSchema !== 'undefined' ? organizationSchema : null,
    typeof personSchema !== 'undefined' ? personSchema : null
  ].filter(Boolean);
  identityBlocks.forEach(function(identity) {
    const supplied = typeof structuredDataBlocks !== 'undefined' && Array.isArray(structuredDataBlocks)
      && structuredDataBlocks.some(block => block && (block['@id'] === identity['@id'] || block['@graph']?.some(node => node['@id'] === identity['@id'])));
    if (!supplied) { %>
  <script type="application/ld+json"><%- JSON.stringify(identity).replace(/</g, '\\u003C') %></script>
  <% } }); %>

  <% if (typeof structuredDataRaw === 'string' && structuredDataRaw.trim()) { %>
  <%- structuredDataRaw %>
  <% } %>

  <% if (typeof structuredDataBlocks !== 'undefined' && structuredDataBlocks !== null) {
    const blocks = Array.isArray(structuredDataBlocks) ? structuredDataBlocks : [structuredDataBlocks];
    const renderJsonLd = typeof escapeJsonForHtml === 'function'
      ? escapeJsonForHtml
      : function(value) { return JSON.stringify(value ?? null).replace(/[<>&\u2028\u2029]/g, function(ch) {
        return ch === '<' ? '\\u003C' : ch === '>' ? '\\u003E' : ch === '&' ? '\\u0026' : ch === '\u2028' ? '\\u2028' : '\\u2029';
      }); };
    blocks.filter(Boolean).forEach(function(block) { %>
  <script type="application/ld+json"><%- typeof block === 'string' ? block.replace(/[<>&\u2028\u2029]/g, function(ch) {
    return ch === '<' ? '\\u003C' : ch === '>' ? '\\u003E' : ch === '&' ? '\\u0026' : ch === '\u2028' ? '\\u2028' : '\\u2029';
  }) : renderJsonLd(block) %></script>
  <% });
  } %>

  <% if (!trackingDisabled) { %>
  <!-- =========================================================
       DSGVO-SICHER / BASIC CONSENT MODE
       - Default denied VOR jeglichem Google-Script
       - GA & Clarity werden erst nach Einwilligung geladen
       - KEINE Auto-Pageviews im Head
       ========================================================= -->
  <script>
    // globale IDs für clientseitige Scripts
    window.env = {
      GA_MEASUREMENT_ID: "<%= process.env.GA_MEASUREMENT_ID %>",
      CLARITY_ID: "<%= process.env.CLARITY_ID %>"
    };
    window.KWD_TRACKING_CONTEXT = <%- JSON.stringify(safeTrackingContext) %>;

    // Consent Mode Defaults (alles denied)
    window.dataLayer = window.dataLayer || [];

    function gtag() {
      dataLayer.push(arguments);
    }

    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500
    });

    // --------- GA Loader (wird NUR nach Consent aufgerufen) ---------
    function loadGA() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;

      var s = document.createElement('script');
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=<%= process.env.GA_MEASUREMENT_ID %>";
      document.head.appendChild(s);

      s.onload = function() {
        gtag('js', new Date());
        gtag('config', "<%= process.env.GA_MEASUREMENT_ID %>", {
          send_page_view: false, // PV kommt erst per cookie-consent.js
          allow_google_signals: false // wird dort je nach marketing gesetzt
        });
      };
    }

    // Hook für dein Banner:
    // cookie-consent.js ruft bei Analytics-Einwilligung updateAnalyticsConsent(true) auf
    window.updateAnalyticsConsent = function(granted) {
      gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied'
      });
      if (granted) loadGA();
    };

    // --------- Clarity Loader (nur nach Consent) ---------
    window.loadClarity = function() {
      var id = window.env && window.env.CLARITY_ID;
      if (!id) return;
      if (window.clarity) return;
      if (document.querySelector('script[src*="clarity.ms/tag/"]')) return;

      (function(c, l, a, r, i, t, y) {
        c[a] = c[a] || function() {
          (c[a].q = c[a].q || []).push(arguments)
        };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + id;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script");

      (function tryConsent() {
        if (typeof window.clarity === 'function') {
          try {
            window.clarity('consent', true);
          } catch (e) {}
        } else setTimeout(tryConsent, 200);
      })();
    };
  </script>
  <% } %>
</head>
