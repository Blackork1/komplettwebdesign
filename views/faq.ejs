<%
const structuredDataBlocks = (typeof faqJsonLd === 'string' && faqJsonLd.trim()) ? [faqJsonLd] : [];
%>
<%- include('partials/head', { structuredDataBlocks, extraCssAssets: ['faq.css'], disableInteractionPolish: true }) %>
<body class="faq-page">
<%- include('partials/header') %>

<main class="faq-main">
  <div class="faq-shell">
    <header class="faq-intro">
      <h1>Deine Fragen.<br><span>Klare Antworten.</span></h1>
      <p>Alles Wichtige zu Leistungen, Preisen und unserer Zusammenarbeit.</p>
    </header>

    <nav class="faq-topics" aria-label="FAQ-Themen">
      <% categories.forEach(category => { %>
      <a href="/faq<%= Number(category.id) === 1 ? '' : '?cat=' + category.id %>"<% if (Number(category.id) === Number(selectedCategory.id)) { %> aria-current="page"<% } %>><%= category.name %></a>
      <% }) %>
    </nav>

    <section class="faq-content" aria-labelledby="faq-category-title">
      <h2 id="faq-category-title"><%= selectedCategory.name %></h2>
      <div id="faqAccordion" class="faq-answers">
        <% faqs.forEach((faq, index) => { %>
        <details class="faq-item" name="website-faq"<% if (index === 0) { %> open<% } %>>
          <summary class="faq-question">
            <h3><%= faq.question %></h3>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="faq-icon-plus" d="M5 12h14M12 5v14"/><path class="faq-icon-open" d="m5 9 7 7 7-7"/></svg>
          </summary>
          <div class="faq-answer"><%- faq.answer %></div>
        </details>
        <% }) %>
      </div>
    </section>

    <section class="faq-next-step" aria-labelledby="faq-next-title">
      <div><h2 id="faq-next-title">Noch eine Frage offen?</h2><p>Schreib mir kurz, worum es geht.</p></div>
      <div class="faq-next-actions">
        <a class="faq-contact-button" href="/kontakt">Frage stellen</a>
        <a class="faq-booking-link" href="/booking">Kennenlerngespräch</a>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer', { disableInteractionPolish: true }) %>
