<%
const siteBase = 'https://www.komplettwebdesign.de';
const districtUrl = `${siteBase}${districtPath}`;
const districtStartPriceLabel = (typeof packagePriceLabel === 'function' && packagePriceLabel('start')) || '';
const districtIndividuellPriceLabel = (typeof packagePriceLabel === 'function' && packagePriceLabel('individuell')) || '';
const heroSize = Array.isArray(districtPage.imageSize) ? districtPage.imageSize : [720, 540];
const structuredDataBlocks = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${districtUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Webdesign Berlin", item: `${siteBase}/` },
      { "@type": "ListItem", position: 2, name: district.name, item: districtUrl }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${districtUrl}#service`,
    name: `Webdesign in ${district.name}`,
    description: districtPage.metaDescription,
    url: districtUrl,
    provider: { "@id": `${siteBase}/#organization` },
    image: districtPage.heroImage,
    priceRange: `${districtStartPriceLabel || 'nach Angebot'} bis ${districtIndividuellPriceLabel || 'nach Angebot'}`,
    areaServed: [
      { "@type": "City", name: "Berlin" },
      { "@type": "AdministrativeArea", name: district.name }
    ],
    serviceType: ["Webdesign", "Website erstellen", "Local SEO", "Website-Relaunch"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: (faqItems || []).map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a }
    }))
  }
];
%>
<%- include('../partials/head', { structuredDataBlocks, extraCssAssets: ['webdesign-berlin.css'] }) %>
<%- include('../partials/header') %>

<main class="webdesign-berlin-page webdesign-berlin district-bezirk" id="content">
  <section id="hero" class="wd-container wd-hero unified-hero" aria-labelledby="district-hero-title">
    <div class="wd-hero__copy unified-hero__copy">
      <nav class="district-breadcrumb unified-hero__breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= hubPath %>">Webdesign Berlin</a></li>
          <li aria-current="page"><%= district.name %></li>
        </ol>
      </nav>
      <span class="wd-chip"><%= districtPage.label %></span>
      <h1 id="district-hero-title"><%= districtPage.h1 %></h1>
      <p class="wd-lead"><%= districtPage.lead %></p>
      <% if (Array.isArray(districtPage.heroHighlights) && districtPage.heroHighlights.length) { %>
      <ul class="wd-hero-bullets" aria-label="Schwerpunkte für <%= district.name %>">
        <% districtPage.heroHighlights.forEach((item) => { %>
        <li>
          <img src="/images/icons/check.svg" alt="" width="26" height="26" loading="lazy">
          <span><%= item %></span>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <div class="wd-actions">
        <a class="btn btn-primary" href="<%= contactPath %>" data-track="district_hero_contact">Kostenloses Erstgespräch</a>
        <a class="btn btn-secondary" href="/pakete" data-track="district_hero_packages">Pakete ansehen</a>
      </div>
    </div>
    <figure class="wd-hero__media">
      <img src="<%= districtPage.heroImage %>" alt="<%= districtPage.imageAlt %>" width="<%= heroSize[0] %>" height="<%= heroSize[1] %>" loading="eager" fetchpriority="high" decoding="async">
    </figure>
  </section>

  <% if (districtPage.market) { %>
  <section id="markt" class="wd-section" aria-labelledby="district-market-title">
    <div class="wd-container wd-section-head">
      <span class="wd-chip"><%= district.name %> verstehen</span>
      <h2 id="district-market-title"><%= districtPage.market.title %></h2>
      <% (districtPage.market.paragraphs || []).forEach((paragraph) => { %>
      <p class="wd-lead"><%= paragraph %></p>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (districtPage.neighborhoodDetails && districtPage.neighborhoodDetails.length) { %>
  <section id="kieze" class="wd-section wd-section--soft" aria-labelledby="district-places-title">
    <div class="wd-container">
      <div class="wd-section-head">
        <span class="wd-chip">Kieze und Orte</span>
        <h2 id="district-places-title">Wo deine Kundschaft in <%= district.name %> unterwegs ist</h2>
      </div>
      <div class="wd-grid wd-grid--two district-bezirk__places">
        <% districtPage.neighborhoodDetails.forEach((area) => { %>
        <article class="wd-card">
          <h3><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= area.name %></h3>
          <p><%= area.text %></p>
        </article>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (districtPage.audiences && districtPage.audiences.length) { %>
  <section id="branchen" class="wd-section" aria-labelledby="district-audience-title">
    <div class="wd-container">
      <div class="wd-section-head">
        <span class="wd-chip">Branchen</span>
        <h2 id="district-audience-title">Typische Betriebe in <%= district.name %> und was ihre Website braucht</h2>
      </div>
      <div class="wd-grid wd-grid--two">
        <% districtPage.audiences.forEach((audience) => { %>
        <article class="wd-card">
          <h3><%= audience.title %></h3>
          <p><%= audience.text %></p>
        </article>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (districtPage.example) { %>
  <section id="beispiel" class="wd-section wd-section--soft" aria-labelledby="district-example-title">
    <div class="wd-container wd-split">
      <article class="wd-card">
        <span class="wd-chip">Beispiel</span>
        <h2 id="district-example-title"><%= districtPage.example.title %></h2>
        <p><%= districtPage.example.intro %></p>
        <ol class="wd-list wd-list--checks">
          <% districtPage.example.pages.forEach((item) => { %>
          <li><%= item %></li>
          <% }) %>
        </ol>
      </article>
      <article class="wd-card">
        <h3><%= districtPage.example.focusTitle %></h3>
        <ul class="wd-list wd-list--checks">
          <% districtPage.example.focus.forEach((item) => { %>
          <li><%= item %></li>
          <% }) %>
        </ul>
        <% if (districtServiceLinks && districtServiceLinks.length) { %>
        <div class="wd-link-row wd-link-row--split">
          <% districtServiceLinks.forEach((item) => { %>
          <a href="<%= item.href %>"><%= item.label %></a>
          <% }) %>
        </div>
        <% } %>
      </article>
    </div>
  </section>
  <% } %>

  <section id="pakete" class="wd-section" aria-labelledby="district-packages-title">
    <div class="wd-container">
      <div class="wd-section-head">
        <span class="wd-chip">Preise</span>
        <h2 id="district-packages-title">Website-Pakete für <%= district.name %></h2>
        <% if (districtPage.packageLead) { %><p class="wd-lead"><%= districtPage.packageLead %></p><% } %>
      </div>
      <div class="wd-grid wd-grid--three district-bezirk__packages">
        <% packageCards.forEach((pkg) => { %>
        <article class="wd-card wd-package<%= pkg.featured ? ' wd-package--featured' : '' %>">
          <% if (pkg.featured) { %>
          <span class="wd-package__label">Häufig passend</span>
          <% } else { %>
          <span class="wd-package__label wd-package__label--placeholder" aria-hidden="true">Paket</span>
          <% } %>
          <h3><%= pkg.name %></h3>
          <span class="wd-package__price"><%= pkg.price %></span>
          <p><%= pkg.short %></p>
          <ul class="wd-list">
            <% pkg.features.forEach((feature) => { %>
            <li><%= feature %></li>
            <% }) %>
          </ul>
          <a class="btn btn-primary" href="<%= pkg.href %>"><%= pkg.name %>-Paket ansehen</a>
        </article>
        <% }) %>
      </div>
      <p class="district-bezirk__note">Hosting, Domain, E-Mail und Wartung sind optional und werden separat vereinbart. <a href="/webdesign-berlin/kosten-preise-pakete">Was eine Website in Berlin insgesamt kostet</a></p>
    </div>
  </section>

  <section id="vertrauen" class="wd-section wd-section--soft" aria-labelledby="district-trust-title">
    <div class="wd-container wd-split">
      <article class="wd-card">
        <span class="wd-chip">Bewertungen</span>
        <h2 id="district-trust-title">Was Kundinnen und Kunden sagen</h2>
        <p>Die Bewertungen zur Zusammenarbeit sind öffentlich im Google-Unternehmensprofil nachlesbar.</p>
        <% if (districtPage.googleRating && districtPage.googleRating.href) { %>
        <div class="wd-link-row">
          <a href="<%= districtPage.googleRating.href %>" target="_blank" rel="noopener"><%= districtPage.googleRating.label %></a>
        </div>
        <% } %>
      </article>
      <article class="wd-card">
        <h3>Referenzen aus Berlin</h3>
        <ul class="wd-list district-bezirk__references">
          <% (districtPage.references || []).forEach((project) => { %>
          <li>
            <span><a href="<%= project.href %>"><%= project.name %></a>: <%= project.text %></span>
          </li>
          <% }) %>
        </ul>
      </article>
    </div>
  </section>

  <section id="faq" class="wd-section" aria-labelledby="district-faq-title">
    <div class="wd-container">
      <div class="wd-section-head">
        <span class="wd-chip">FAQ</span>
        <h2 id="district-faq-title">Häufige Fragen zu Websites in <%= district.name %></h2>
      </div>
      <div class="wd-faq">
        <% faqItems.forEach((faq, index) => { %>
        <details<%= index === 0 ? ' open' : '' %>>
          <summary><%= faq.q %></summary>
          <p><%= faq.a %></p>
        </details>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="kontakt" class="wd-section wd-section--soft" aria-labelledby="district-cta-title">
    <div class="wd-container">
      <div class="wd-cta">
        <h2 id="district-cta-title"><%= districtPage.cta ? districtPage.cta.title : `Website erstellen lassen in ${district.name}` %></h2>
        <% if (districtPage.cta && districtPage.cta.text) { %><p class="wd-lead"><%= districtPage.cta.text %></p><% } %>
        <div class="wd-actions">
          <a class="btn btn-primary" href="<%= contactPath %>" data-track="district_final_contact">Kostenloses Erstgespräch</a>
          <a class="btn btn-secondary" href="tel:<%= phone %>" data-track="district_final_phone"><%= phoneDisplay %></a>
        </div>
      </div>
      <% if (Array.isArray(otherDistricts) && otherDistricts.length) { %>
      <nav class="district-bezirk__others" aria-label="Weitere Bezirksseiten">
        <span>Weitere Bezirke:</span>
        <% otherDistricts.forEach((item) => { %>
        <a href="<%= item.href %>"><%= item.name %></a>
        <% }) %>
        <a href="<%= hubPath %>">Alles zu Webdesign Berlin</a>
      </nav>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
